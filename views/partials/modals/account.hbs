{{!-- Modal: Tambah / edit akun. Kolom detail menyesuaikan jenis akun (bank, e-wallet, tunai). --}}
<template x-if="modal === 'account'">
  <div class="stack">
    <h2 x-text="form.id ? 'Edit akun' : 'Tambah akun'"></h2>

    <div class="field">
      <label>Jenis akun</label>
      <div class="segmented">
        <template x-for="[type, info] in Object.entries(ACCOUNT_TYPES).filter(([type]) => type !== 'goal')">
          <button type="button" :class="{ active: form.type === type }" @click="form.type = type; form.provider = ''">
            <i class="ph-duotone" :class="'ph-' + info.icon"></i> <span x-text="info.label"></span>
          </button>
        </template>
      </div>
    </div>

    <!-- Detail sesuai jenis -->
    <div class="account-details">
      <div class="field">
        <label x-text="ACCOUNT_FIELDS[form.type].provider"></label>
        <input list="account-providers" x-model="form.provider" autocomplete="off" autofocus
               :placeholder="{ bank: 'contoh: BCA, Mandiri, Bank Jago', ewallet: 'contoh: GoPay, OVO, DANA', emoney: 'contoh: Mandiri e-money, BCA Flazz' }[form.type] ?? 'contoh: Dompet, Celengan'">
        <datalist id="account-providers">
          <template x-for="name in ACCOUNT_PROVIDERS[form.type]" :key="name"><option :value="name"></option></template>
        </datalist>
        <div class="chips provider-chips">
          <template x-for="name in ACCOUNT_PROVIDERS[form.type].slice(0, form.type === 'bank' ? 8 : 6)" :key="name">
            <button type="button" class="chip small" :class="{ active: form.provider === name }" @click="form.provider = name" x-text="name"></button>
          </template>
        </div>
      </div>

      <template x-if="form.type !== 'cash'">
        <div class="grid-2 tight">
          <div class="field">
            <label x-text="ACCOUNT_FIELDS[form.type].number + ' (opsional)'"></label>
            <input inputmode="numeric" autocomplete="off" x-model="form.account_number"
                   :placeholder="{ bank: 'contoh: 1234 5678 90', emoney: 'contoh: 6032 9812 3456 7890' }[form.type] ?? 'contoh: 0812 3456 7890'">
            <p class="hint" x-text="ACCOUNT_FIELDS[form.type].numberHint"></p>
          </div>
          <div class="field" x-show="form.type !== 'emoney'">
            <label>Atas nama (opsional)</label>
            <input autocomplete="off" placeholder="nama pemilik" x-model="form.holder_name">
          </div>
        </div>
      </template>
    </div>

    <div class="grid-2 tight">
      <div class="field">
        <label>Nama tampilan</label>
        <input :placeholder="form.provider ? 'kosongkan = ' + form.provider : 'contoh: BCA Gaji, Tabungan Nikah'" x-model="form.name">
        <p class="hint">Berguna kalau punya 2 rekening di bank yang sama.</p>
      </div>
      {{> components/amount-field label="Saldo awal" placeholder="0"
          hint="(form.id ? 'Saldo sebelum transaksi pertama dicatat. ' : '') + '= ' + rupiah(parsedAmount)"}}
    </div>

    <!-- Saldo awal sebagai pemasukan (hanya saat membuat akun) -->
    <div class="expense-toggle income-toggle" x-show="!form.id && parsedAmount > 0">
      <label class="checkbox">
        <input type="checkbox" x-model="form.asIncome">
        <span><strong>Catat saldo awal sebagai pemasukan</strong>
          <small class="muted">Centang kalau uangnya baru diterima (misal gaji masuk ke rekening baru). Kalau tidak, dianggap uang lama yang sudah kamu punya.</small></span>
      </label>
      <div class="grid-2 tight" x-show="form.asIncome">
        <div class="field">
          <label>Kategori pemasukan</label>
          <select x-model="form.income_category_id">
            <template x-for="c in categoriesOf('income')" :key="c.id"><option :value="c.id" x-text="c.name" :selected="c.id == form.income_category_id"></option></template>
          </select>
        </div>
        <div class="field"><label>Tanggal diterima</label><input type="date" x-model="form.income_date"></div>
      </div>
    </div>

    <div class="field"><label>Catatan (opsional)</label><input placeholder="contoh: khusus dana darurat, cabang Sudirman" x-model="form.note"></div>

    <p class="hint" x-show="form.id">
      Untuk mencocokkan dengan saldo asli hari ini, lebih mudah pakai <strong>Sesuaikan saldo</strong>.
    </p>
    {{> components/form-actions submit="saveAccount()"}}
  </div>
</template>
