{{!-- Modal: Utang / piutang / invoice baru. Bagian: siapa & berapa · cicilan · uangnya ke mana · catatan --}}
<template x-if="modal === 'debt'">
  <div class="stack">
    <h2 x-text="form.type === 'invoice' ? 'Catat invoice klien' : form.direction === 'payable' ? 'Catat utang' : 'Catat piutang'"></h2>
    <p class="hint" x-show="form.type === 'invoice'">Untuk proyek yang sudah dikerjakan tapi belum dibayar. Saat klien membayar, uangnya dicatat sebagai <strong>pemasukan</strong>.</p>

    <!-- Siapa & berapa -->
    <div class="debt-grid">
      <div class="field">
        <label x-text="form.type === 'invoice' ? 'Klien' : form.direction === 'payable' ? 'Pinjam dari' : 'Dipinjam oleh'"></label>
        <input autofocus :placeholder="form.type === 'invoice' ? 'contoh: nama perusahaan / klien' : 'contoh: nama orang, bank, atau aplikasi'" x-model="form.counterparty">
      </div>
      <div class="field" x-show="form.type !== 'invoice'">
        <label>Jenis</label>
        <select x-model="form.type">
          <template x-for="[value, label] in debtTypesFor(form.direction)"><option :value="value" x-text="label" :selected="value === form.type"></option></template>
        </select>
      </div>
      <div class="field">
        <label x-text="form.type === 'invoice' ? 'Nilai invoice' : 'Jumlah pokok'"></label>
        <input inputmode="decimal" x-rupiah placeholder="contoh: 2jt" x-model="form.amountText">
        <p class="hint" x-text="parsedAmount ? '= ' + rupiah(parsedAmount) : 'Uang yang dipinjam, tanpa bunga'"></p>
      </div>
      <div class="field" x-show="form.direction === 'payable'">
        <label>Total harus dibayar <span class="muted">(opsional)</span></label>
        <input inputmode="decimal" x-rupiah placeholder="pokok + bunga & biaya" x-model="form.totalText">
        <p class="hint">Kosongkan kalau tanpa bunga.</p>
      </div>
    </div>

    <!-- Cicilan -->
    <div class="debt-section" x-show="form.type !== 'invoice'">
      <div class="field">
        <label>Dicicil?</label>
        <div class="tenor-row">
          <div class="chips">
            <button type="button" class="chip" :class="{ active: !form.tenor }" @click="form.tenor = ''">Tidak</button>
            <template x-for="months in TENOR_CHOICES" :key="months">
              <button type="button" class="chip" :class="{ active: form.tenor == months }" @click="form.tenor = months" x-text="months + ' bln'"></button>
            </template>
          </div>
          <div class="percent-input tenor-input">
            <input type="number" min="1" max="360" placeholder="lainnya" x-model="form.tenor">
            <span>bln</span>
          </div>
        </div>
      </div>

      <template x-if="form.tenor">
        <div class="stack-sm">
          <div class="grid-2 tight">
            <div class="field">
              <label>Cicilan per bulan</label>
              <input inputmode="decimal" x-rupiah x-model="form.installmentText"
                     :placeholder="'otomatis ' + rupiah(Math.ceil((debtTerms.total || 0) / form.tenor))">
            </div>
            <div class="field">
              <label>Cicilan ke-1 jatuh tempo</label>
              <input type="date" x-model="form.first_due">
            </div>
          </div>
          <div class="terms-preview" x-show="debtTerms.installment">
            <i class="ph-duotone ph-calculator"></i>
            <div>
              <strong x-text="debtTerms.tenor + ' × ' + rupiah(debtTerms.installment) + ' = ' + rupiah(debtTerms.total)"></strong>
              <p class="hint" x-text="(debtTerms.finish ? 'Lunas ' + debtTerms.finish + '. ' : '')
                + (form.direction === 'payable' ? 'Otomatis dibuatkan tagihan bulanan.' : 'Pembayaran dari peminjam dicatat per bulan.')"></p>
            </div>
          </div>
        </div>
      </template>
    </div>

    <!-- Uangnya ke mana -->
    <div class="debt-section" x-show="form.type !== 'invoice'">
      <div class="field">
        <label x-text="form.direction === 'payable' ? 'Uang pinjamannya' : 'Uang yang dipinjamkan'"></label>
        <div class="segmented">
          <button type="button" :class="{ active: form.recordCash }" @click="form.recordCash = true; form.count_as_expense = false">
            <i class="ph-duotone ph-wallet"></i> <span x-text="form.direction === 'payable' ? 'Masuk ke akun saya' : 'Keluar dari akun saya'"></span>
          </button>
          <button type="button" :class="{ active: !form.recordCash }" @click="form.recordCash = false; form.count_as_expense = form.direction === 'payable'">
            <i class="ph-duotone ph-note-pencil"></i> Catat saja
          </button>
        </div>
      </div>
      {{> components/account-select label="Akun" show="form.recordCash"}}
      <label class="checkbox expense-toggle" x-show="!form.recordCash && form.direction === 'payable'">
        <input type="checkbox" x-model="form.count_as_expense">
        <span><strong>Hitung pembayarannya sebagai pengeluaran</strong>
          <small class="muted">Masuk laporan & anggaran kategori "Bayar utang". Cocok kalau uang pinjamannya tidak dicatat masuk (misal paylater untuk belanja).</small></span>
      </label>
    </div>

    <div class="debt-grid">
      <div class="field" x-show="!form.tenor">
        <label x-text="form.type === 'invoice' ? 'Jatuh tempo pembayaran' : 'Jatuh tempo pelunasan (opsional)'"></label>
        <input type="date" x-model="form.due_date">
      </div>
      <div class="field"><label>Catatan (opsional)</label><input placeholder="contoh: untuk beli laptop" x-model="form.note"></div>
    </div>
    {{> components/form-actions submit="saveDebt()"}}
  </div>
</template>
