{{!-- Modal: Import mutasi rekening (CSV / Excel internet banking) --}}
<template x-if="modal === 'import'">
  <div class="stack">
    <div class="card-header">
      <h2>Import mutasi rekening</h2>
      <span class="badge" x-show="form.fileName" x-text="form.fileName"></span>
    </div>

    <!-- 1. Akun & file -->
    <div class="import-file">
      <div class="field">
        <label>Masuk ke akun</label>
        <select x-model="form.account_id" @change="form.raw.length && refreshImportPreview()">
          <template x-for="a in regularAccounts" :key="a.id"><option :value="a.id" x-text="a.name" :selected="a.id == form.account_id"></option></template>
        </select>
      </div>
      <div class="field">
        <label>Tahun mutasi</label>
        <input type="number" min="2000" max="2100" x-model="form.year" @change="form.raw.length && refreshImportPreview()">
      </div>
      <label class="import-drop" :class="{ loaded: form.fileName }">
        <i class="ph-duotone" :class="form.loading ? 'ph-spinner' : 'ph-file-arrow-up'"></i>
        <strong x-text="form.loading ? 'Membaca file…' : form.fileName ? 'Ganti file' : 'Pilih file mutasi'"></strong>
        <small>CSV atau Excel (.xlsx / .xls) dari internet banking</small>
        <input type="file" accept=".csv,.xlsx,.xls,text/csv" hidden @change="pickImportFile($event)">
      </label>
    </div>
    <p class="hint" x-show="form.step === 'file'">
      <i class="ph-duotone ph-info"></i> Unduh mutasi dari KlikBCA / Livin' / BRImo / Jago / dll. dalam format CSV atau Excel.
      Tahun dipakai kalau tanggal di file tidak mencantumkan tahun (misal mutasi BCA "05/10").
    </p>

    <!-- 2. Kolom -->
    <template x-if="form.step === 'review'">
      <div class="import-mapping">
        <span class="muted">Kolom terbaca:</span>
        <template x-for="[key, label] in IMPORT_COLUMNS" :key="key">
          <label class="import-map">
            <small x-text="label"></small>
            <select x-model="form.mapping[key]" @change="refreshImportPreview()">
              <option value="-1">—</option>
              <template x-for="(name, index) in form.header" :key="index">
                <option :value="index" :selected="index == form.mapping[key]" x-text="String(name || 'Kolom ' + (index + 1))"></option>
              </template>
            </select>
          </label>
        </template>
      </div>
    </template>

    <!-- 3. Tinjau -->
    <template x-if="form.step === 'review' && form.items.length === 0">
      {{> components/empty-state emoji="1f50d" title="Belum ada baris yang terbaca" text="Cek pilihan kolom di atas: minimal Tanggal dan Nominal (atau Debit/Kredit)."}}
    </template>
    <template x-if="form.items.length">
      <div class="stack-sm">
        <div class="import-summary">
          <span><strong x-text="importSelected.length"></strong> dari <span x-text="form.items.length"></span> dipilih</span>
          <span class="tone-positive" x-text="'+' + money(importTotals.income)"></span>
          <span class="tone-negative" x-text="'−' + money(importTotals.expense)"></span>
          <span class="spacer"></span>
          <button type="button" class="link" @click="setAllImport(true)">Pilih semua</button>
          <button type="button" class="link" @click="setAllImport(false)">Kosongkan</button>
        </div>
        <div class="import-table">
          <template x-for="item in form.items" :key="item.id">
            <div class="import-row" :class="{ off: !item.selected }">
              <input type="checkbox" x-model="item.selected">
              <span class="import-date" x-text="formatDate(item.date)"></span>
              <div class="import-desc">
                <input class="import-note" x-model="item.note">
                <span class="import-flags" x-show="item.duplicate || item.guessed_by === 'history'">
                  <span class="badge badge-warning" x-show="item.duplicate" title="Tanggal, nominal & jenis sama sudah ada di akun ini">Mungkin sudah tercatat</span>
                  <span class="badge badge-info" x-show="!item.duplicate && item.guessed_by === 'history'" title="Kategori dari transaksi serupa sebelumnya">Kategori dari riwayat</span>
                </span>
              </div>
              <button type="button" class="chip small" :class="item.kind === 'income' ? 'kind-income' : 'kind-expense'" @click="toggleImportKind(item)"
                      x-text="(item.kind === 'income' ? '+' : '−') + money(item.amount)" title="Klik untuk menukar pemasukan / pengeluaran"></button>
              <select x-model="item.category_id">
                <template x-for="c in categoriesOf(item.kind)" :key="c.id"><option :value="c.id" x-text="c.name" :selected="c.id == item.category_id"></option></template>
              </select>
            </div>
          </template>
        </div>
      </div>
    </template>

    <div class="form-actions">
      <span class="spacer"></span>
      <button type="button" class="button" @click="close()">Batal</button>
      <button class="button primary" @click="saveImport()" :disabled="!importSelected.length">
        <i class="ph-duotone ph-download-simple"></i> <span x-text="'Import ' + importSelected.length + ' transaksi'"></span>
      </button>
    </div>
  </div>
</template>
