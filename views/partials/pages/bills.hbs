{{!-- Halaman: Tagihan --}}
<section class="page stack" x-show="page === 'bills'">
  <div class="card stat summary-bar">
    <i class="ph-fill ph-calendar-dots tone-info"></i>
    <div class="grow">
      <p class="label">Total tagihan rutin per bulan</p>
      <p class="stat-value" x-text="money(monthlyBillsTotal)"></p>
      <p class="hint">Setara <span x-text="money(monthlyBillsTotal * 12)"></span> per tahun</p>
    </div>
    <button class="button primary" @click="openBill()">
      <i class="ph-duotone ph-plus"></i> Tambah tagihan
    </button>
  </div>

  <div class="card">
    <template x-if="bills.length === 0">
      {{> components/empty-state emoji="1f4c5" title="Belum ada tagihan rutin" text="Netflix, listrik, internet, kos, asuransi… catat sekali, nanti diingatkan setiap periode." action="openBill()" actionLabel="Tambah tagihan"}}
    </template>
    <ul class="list">
      <template x-for="bill in bills" :key="bill.id">
        <li class="row bill-row">
          <span class="avatar" :style="{ background: bill.category_color ?? '#8b5cf6' }">
            <i class="ph-duotone" :class="bill.debt_id ? 'ph-hand-coins' : 'ph-' + (bill.category_icon ?? 'receipt')"></i>
          </span>
          <div class="row-main">
            <strong x-text="bill.name"></strong>
            <span class="muted" x-text="FREQUENCIES[bill.frequency] + (bill.account_name ? ' · ' + bill.account_name : '')"></span>
          </div>
          <span class="badge" :class="'badge-' + billStatus(bill).tone" x-text="billStatus(bill).text"></span>
          <strong class="amount" x-text="money(bill.amount)"></strong>
          <div class="row-actions">
            <button class="button small positive" @click="openPayBill(bill)"><i class="ph-duotone ph-check"></i> Bayar</button>
            <button class="button small" @click="skipBill(bill)">Lewati</button>
            <button class="icon-button subtle" title="Edit" @click="openBill(bill)"><i class="ph-duotone ph-pencil-simple"></i></button>
            <button class="icon-button subtle" title="Hapus" :class="{ invisible: bill.debt_id }"
              @click="deleteBill(bill)">
              <i class="ph-duotone ph-trash"></i>
            </button>
          </div>
        </li>
      </template>
    </ul>
  </div>
</section>
