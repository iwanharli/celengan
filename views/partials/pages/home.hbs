{{!-- Halaman: Beranda --}}
<section class="page stack" x-show="page === 'home'">
  <template x-if="accounts.length === 0">
    <div class="card welcome">
      <img class="welcome-emoji" :src="emojiUrl('1f44b')" alt="">
      <div class="grow">
        <h2>Halo, selamat datang! Yuk mulai dari 3 langkah ini</h2>
        <ol class="steps">
          <li><span>1</span> Tambah akun: dompet, rekening bank, atau e-wallet beserta saldonya sekarang</li>
          <li><span>2</span> Catat pemasukan & pengeluaran setiap hari (cukup ketik "25rb")</li>
          <li><span>3</span> Atur tagihan rutin & anggaran supaya tidak kebobolan</li>
        </ol>
      </div>
      <button class="button primary" @click="goTo('accounts'); openAccount()">
        <i class="ph-duotone ph-wallet"></i> Tambah akun pertama
      </button>
    </div>
  </template>

  <div class="hero card">
    <div>
      <p class="label">Total saldo semua akun</p>
      <p class="big-number" x-countup="summary.totalBalance"></p>
      <!-- Hanya muncul bila ada utang aktif -->
      <button class="hero-debt" x-show="summary.debts.payable > 0" @click="goTo('debts')" title="Lihat utang">
        <i class="ph-duotone ph-hand-coins"></i>
        <span>Setelah dikurangi utang aktif (<span x-text="money(summary.debts.payable)"></span>):
          <strong x-text="money(summary.totalBalance - summary.debts.payable)"></strong></span>
      </button>
    </div>
    <img class="hero-emoji" src="https://cdn.jsdelivr.net/npm/@lobehub/fluent-emoji-3d@1.1.0/assets/1f4b0.webp" alt="">
    <div class="hero-actions">
      <button class="button positive" @click="openTransaction('income')"><i class="ph-duotone ph-plus"></i> Pemasukan</button>
      <button class="button negative" @click="openTransaction('expense')"><i class="ph-duotone ph-minus"></i> Pengeluaran</button>
      <button class="button" x-show="isFreelance" @click="openPaidProject()"><i class="ph-duotone ph-laptop"></i> Proyek dibayar</button>
      <button class="button" @click="openTransaction('transfer')"><i class="ph-duotone ph-arrows-left-right"></i> Transfer</button>
    </div>
  </div>

  <div class="grid-3">
    <div class="card stat">
      <i class="ph-fill ph-arrow-circle-down tone-positive"></i>
      <div><p class="label">Pemasukan</p><p class="stat-value" x-countup="summary.income"></p></div>
    </div>
    <div class="card stat">
      <i class="ph-fill ph-arrow-circle-up tone-negative"></i>
      <div><p class="label">Pengeluaran</p><p class="stat-value" x-countup="summary.expense"></p></div>
    </div>
    <div class="card stat" x-show="!isFreelance">
      <i class="ph-fill ph-shield-check tone-info"></i>
      <div>
        <p class="label">Aman dipakai sampai gajian</p>
        <p class="stat-value" :class="summary.safeToSpend < 0 && 'tone-negative'" x-countup="summary.safeToSpend"></p>
        <p class="hint" x-show="summary.billsDue > 0">Sudah dikurangi tagihan <span x-text="money(summary.billsDue)"></span></p>
      </div>
    </div>
    <div class="card stat" x-show="isFreelance && !runway">
      <img class="stat-emoji" :src="emojiUrl('1f6df')" alt="">
      <div>
        <p class="label">Dana cukup untuk</p>
        <p class="stat-value tone-muted">Belum terhitung</p>
        <p class="hint">Muncul setelah ada pengeluaran atau tagihan tercatat.</p>
      </div>
    </div>
    <div class="card stat" x-show="isFreelance && runway">
      <img class="stat-emoji" src="https://cdn.jsdelivr.net/npm/@lobehub/fluent-emoji-3d@1.1.0/assets/1f6df.webp" alt="">
      <div>
        <p class="label">Dana cukup untuk</p>
        <p class="stat-value" :class="runway?.tone === 'danger' && 'tone-negative'" x-text="'±' + runway?.text"></p>
        <p class="hint">
          <span class="badge" :class="'badge-' + runway?.tone" x-text="runway?.label"></span>
          Kebutuhan <span x-text="money(summary.savings.monthlyNeed)"></span>/bulan · ideal 6–12 bulan
        </p>
      </div>
    </div>
  </div>

  <!-- Peringatan anggaran (periode berjalan) -->
  <template x-if="budgetAlerts.length">
    <div class="card budget-alerts">
      <div class="card-header">
        <div class="row">
          <img class="stat-emoji" :src="emojiUrl(BUDGET_ALERT_STYLE[budgetAlerts[0].level].emoji)" alt="">
          <div>
            <h2>Peringatan anggaran</h2>
            <p class="muted">
              <span x-text="budgetAlerts.length"></span> kategori perlu diperhatikan ·
              bulan ini sudah berjalan <span x-text="budgetAlerts[0].percentTime"></span>%
            </p>
          </div>
        </div>
        <button class="link" @click="goTo('budget')">Atur anggaran</button>
      </div>
      <ul class="alert-list">
        <template x-for="alert in budgetAlerts" :key="alert.id">
          <li :class="'alert-' + alert.level">
            <span class="avatar" :style="{ background: alert.color }"><i class="ph-duotone" :class="'ph-' + alert.icon"></i></span>
            <div class="row-main">
              <div class="alert-title">
                <strong x-text="alert.name"></strong>
                <span class="badge" :class="'badge-' + BUDGET_ALERT_STYLE[alert.level].tone" x-text="BUDGET_ALERT_STYLE[alert.level].label"></span>
              </div>
              <!-- Bar: isi = terpakai, garis = posisi waktu di bulan ini -->
              <div class="progress with-marker">
                <div :class="'bar-' + (alert.level === 'over' ? 'danger' : alert.level === 'almost' ? 'warning' : 'wish')"
                     :style="{ width: Math.min(100, alert.percentUsed) + '%' }"></div>
                <span class="time-marker" :style="{ left: alert.percentTime + '%' }" title="Posisi hari ini"></span>
              </div>
              <p class="hint" x-show="alert.level === 'over'">
                Sudah <strong x-text="alert.percentUsed + '%'"></strong> — lewat <strong x-text="money(alert.overBy)"></strong>
                dari anggaran <span x-text="money(alert.monthly_budget)"></span>.
              </p>
              <p class="hint" x-show="alert.level !== 'over'">
                <strong x-text="alert.percentUsed + '%'"></strong> terpakai padahal bulan baru berjalan
                <span x-text="alert.percentTime + '%'"></span>.
                <template x-if="alert.projectedOver > 0">
                  <span>Perkiraan akhir bulan <strong x-text="money(alert.projected)"></strong> (lebih <span x-text="money(alert.projectedOver)"></span>).</span>
                </template>
                <template x-if="alert.dailyAllowance > 0">
                  <span>Supaya aman: maks <strong x-text="money(alert.dailyAllowance)"></strong>/hari.</span>
                </template>
              </p>
            </div>
          </li>
        </template>
      </ul>
    </div>
  </template>
  <template x-if="!budgetAlerts.length && hasBudgets && isCurrentPeriod && summary.expense > 0">
    <div class="all-good">
      <img :src="emojiUrl('1f44d')" alt="">
      <span>Semua anggaran bulan ini masih aman. Mantap!</span>
    </div>
  </template>

  <!-- Dana pajak (freelance) -->
  <template x-if="taxEnabled">
    <div class="card tax-card">
      <div class="card-header">
        <div class="row">
          <img class="stat-emoji" :src="emojiUrl('1f9fe')" alt="">
          <div>
            <h2>Dana pajak <span x-text="summary.tax.year"></span></h2>
            <p class="muted" x-text="summary.tax.rate.toString().replace('.', ',') + '% dari pemasukan kena pajak'"></p>
          </div>
        </div>
        <button class="button small primary" @click="openTaxPay()"><i class="ph-duotone ph-bank"></i> Bayar pajak</button>
      </div>
      <div class="grid-4 tax-numbers">
        <div><span class="muted">Sisihkan bulan ini</span><strong x-text="money(summary.tax.periodReserve)"></strong></div>
        <div><span class="muted">Total harus disisihkan</span><strong x-text="money(summary.tax.owed)"></strong></div>
        <div><span class="muted">Sudah dibayar</span><strong class="tone-positive" x-text="money(summary.tax.paid)"></strong></div>
        <div><span class="muted">Sisa dana pajak</span><strong :class="summary.tax.outstanding > 0 && 'tone-negative'" x-text="money(summary.tax.outstanding)"></strong></div>
      </div>
      <div class="progress"><div class="bar-ok" :style="{ width: (summary.tax.owed ? Math.min(100, summary.tax.paid / summary.tax.owed * 100) : 0) + '%' }"></div></div>
      <p class="hint">
        Dari pemasukan kena pajak <span x-text="money(summary.tax.taxableIncome)"></span> tahun ini.
        Sisa dana pajak <strong>tidak dihitung</strong> sebagai uang yang bisa dipakai.
      </p>
    </div>
  </template>

  <!-- Invoice klien yang belum dibayar (freelance) -->
  <template x-if="isFreelance && summary.invoices.items.length">
    <div class="card">
      <div class="card-header">
        <div class="row">
          <img class="stat-emoji" src="https://cdn.jsdelivr.net/npm/@lobehub/fluent-emoji-3d@1.1.0/assets/1f9fe.webp" alt="">
          <div>
            <h2>Menunggu pembayaran klien</h2>
            <p class="muted"><strong x-text="money(summary.invoices.total)"></strong> dari
              <span x-text="summary.invoices.items.length"></span> invoice</p>
          </div>
        </div>
        <button class="link" @click="goTo('debts')">Kelola</button>
      </div>
      <ul class="list">
        <template x-for="invoice in summary.invoices.items.slice(0, 4)" :key="invoice.id">
          <li class="row">
            <span class="avatar" style="background:#0ea5e9"><i class="ph-duotone ph-laptop"></i></span>
            <div class="row-main">
              <strong x-text="invoice.counterparty + (invoice.note ? ' · ' + invoice.note : '')"></strong>
              <span class="badge" :class="'badge-' + invoiceStatus(invoice).tone" x-text="invoiceStatus(invoice).text"></span>
            </div>
            <strong x-text="money(invoice.remaining)"></strong>
            <button class="button small positive" @click="openPayDebt(debts.find(d => d.id === invoice.id))">
              <i class="ph-duotone ph-check"></i> Diterima
            </button>
          </li>
        </template>
      </ul>
    </div>
  </template>

  <!-- Perkiraan tabungan per bulan -->
  <template x-if="!hasSavingsData">
    <div class="card">
      {{> components/empty-state emoji="1f331" title="Perkiraan tabungan belum bisa dihitung" text="Catat pemasukan dan pengeluaranmu dulu. Setelah ada datanya, di sini muncul berapa yang bisa kamu tabung setiap bulan." action="openTransaction('income')" actionLabel="Catat pemasukan" wide=true}}
    </div>
  </template>

  <template x-if="hasSavingsData && savingsMood">
    <div class="card savings" x-data="{ s: null }" x-effect="s = summary.savings">
      <div class="savings-main">
        <img class="savings-emoji" :src="emojiUrl(savingsMood.emoji)" alt="">
        <div>
          <p class="label">Perkiraan bisa ditabung per bulan</p>
          <p class="big-number" :class="s.estimate < 0 && 'tone-negative'" x-countup="s.estimate"></p>
          <div class="schedule-summary">
            <span class="badge" :class="'badge-' + savingsMood.tone" x-text="savingsMood.label"></span>
            <span class="muted" x-show="s.percent !== null" x-text="s.percent + '% dari pemasukan'"></span>
          </div>
          <p class="hint" x-text="savingsMood.tip"></p>
        </div>
      </div>

      <ul class="savings-breakdown">
        <li><span><i class="ph-duotone ph-arrow-circle-down tone-positive"></i> Rata-rata pemasukan</span><strong x-text="money(s.income)"></strong></li>
        <li><span><i class="ph-duotone ph-shopping-cart"></i> Rata-rata pengeluaran harian</span><strong x-text="'−' + money(s.dailyExpense)"></strong></li>
        <li><span><i class="ph-duotone ph-receipt"></i> Tagihan rutin</span><strong x-text="'−' + money(s.recurringBills)"></strong></li>
        <li><span><i class="ph-duotone ph-hand-coins"></i> Cicilan utang</span><strong x-text="'−' + money(s.installments)"></strong></li>
        <li x-show="s.taxReserve > 0"><span><i class="ph-duotone ph-receipt"></i> Sisihkan pajak</span><strong x-text="'−' + money(s.taxReserve)"></strong></li>
        <li class="total"><span>Bisa ditabung</span><strong :class="s.estimate < 0 && 'tone-negative'" x-text="money(s.estimate)"></strong></li>
      </ul>

      <div class="savings-notes">
        <div class="note" x-show="s.estimate > 0">
          <img :src="emojiUrl('1fa99')" alt="">
          <p>Dalam <strong>6 bulan</strong> bisa terkumpul ±<strong x-text="money(s.estimate * 6)"></strong>,
             dalam <strong>1 tahun</strong> ±<strong x-text="money(s.estimate * 12)"></strong>.</p>
        </div>
        <div class="note" x-show="s.lowScenario">
          <img src="https://cdn.jsdelivr.net/npm/@lobehub/fluent-emoji-3d@1.1.0/assets/1f327-fe0f.webp" alt="">
          <p x-show="s.lowScenario">Di <strong>bulan sepi</strong> (pemasukan <span x-text="money(s.lowScenario?.income)"></span>)
             <span x-show="s.lowScenario?.estimate >= 0">kamu masih bisa menabung <strong x-text="money(s.lowScenario?.estimate)"></strong>.</span>
             <span x-show="s.lowScenario?.estimate < 0" class="tone-negative">kamu minus <strong x-text="money(-s.lowScenario?.estimate)"></strong>, jadi tutup dari dana darurat.</span></p>
        </div>
        <div class="note" x-show="s.relief">
          <img :src="emojiUrl('1f389')" alt="">
          <p x-show="s.relief">Setelah cicilan <strong x-text="s.relief?.name"></strong> selesai
             (<span x-text="s.relief && formatMonthYear(s.relief.lastDue)"></span>), tabunganmu bisa naik jadi
             <strong x-text="money(s.relief?.newEstimate)"></strong> / bulan.</p>
        </div>
        <div class="note" x-show="s.actualLastMonth !== null">
          <img :src="emojiUrl('1f4aa')" alt="">
          <p>Bulan lalu yang benar-benar tersisa: <strong :class="s.actualLastMonth < 0 && 'tone-negative'" x-text="money(s.actualLastMonth)"></strong>.</p>
        </div>
        <p class="hint" x-text="s.isRough
          ? 'Perkiraan masih kasar: baru ada data ' + s.monthsUsed + ' bulan. Makin akurat setelah ' + s.historyMonths + ' bulan pencatatan.'
          : 'Dihitung dari rata-rata ' + s.historyMonths + ' bulan terakhir. Tagihan & cicilan dihitung dari jadwalnya.'"></p>
      </div>
    </div>
  </template>

  <div class="grid-2">
    <div class="card">
      <h2>Pengeluaran per kategori</h2>
      <template x-if="summary.expense === 0">
        {{> components/empty-state emoji="1f967" title="Belum ada pengeluaran" text="Pengeluaran bulan ini akan tampil di sini, dikelompokkan per kategori." action="openTransaction('expense')" actionLabel="Catat pengeluaran"}}
      </template>
      <div class="donut-wrap" x-show="summary.expense > 0">
        <div class="donut"><canvas x-ref="categoryChart"></canvas></div>
        <ul class="legend">
          <template x-for="category in summary.categories.filter(c => c.spent > 0)" :key="category.id">
            <li>
              <span class="dot" :style="{ background: category.color }"></span>
              <span x-text="category.name"></span>
              <strong x-text="money(category.spent)"></strong>
            </li>
          </template>
        </ul>
      </div>
    </div>

    <div class="card">
      <h2>Tren 6 bulan</h2>
      <div class="trend" x-show="hasTrendData"><canvas x-ref="trendChart"></canvas></div>
      <template x-if="!hasTrendData">
        {{> components/empty-state emoji="1f4ca" title="Grafik masih kosong" text="Perbandingan pemasukan & pengeluaran 6 bulan terakhir akan muncul setelah kamu mulai mencatat."}}
      </template>
    </div>
  </div>

  <div class="grid-2">
    <div class="card">
      <div class="card-header">
        <h2>Tagihan 14 hari ke depan</h2>
        <button class="link" @click="goTo('bills')">Lihat semua</button>
      </div>
      <template x-if="summary.upcomingBills.length === 0 && bills.length > 0">
        {{> components/empty-state emoji="1f389" title="Santai dulu!" text="Tidak ada tagihan yang jatuh tempo dalam 14 hari ke depan."}}
      </template>
      <template x-if="bills.length === 0">
        {{> components/empty-state emoji="1f4c5" title="Belum ada tagihan rutin" text="Catat langganan, listrik, internet, atau cicilan supaya diingatkan sebelum jatuh tempo." action="goTo('bills'); openBill()" actionLabel="Tambah tagihan"}}
      </template>
      <ul class="list">
        <template x-for="bill in summary.upcomingBills" :key="bill.id">
          <li class="row">
            <span class="avatar" :style="{ background: bill.category_color ?? '#8b5cf6' }">
              <i class="ph-duotone" :class="bill.debt_id ? 'ph-hand-coins' : 'ph-' + (bill.category_icon ?? 'receipt')"></i>
            </span>
            <div class="row-main">
              <strong x-text="bill.name"></strong>
              <span class="badge" :class="'badge-' + billStatus(bill).tone" x-text="billStatus(bill).text"></span>
            </div>
            <strong x-text="money(bill.amount)"></strong>
          </li>
        </template>
      </ul>
    </div>

    <div class="card">
      <div class="card-header">
        <h2>Transaksi terakhir</h2>
        <button class="link" @click="goTo('transactions')">Lihat semua</button>
      </div>
      <template x-if="summary.recent.length === 0">
        {{> components/empty-state emoji="1f4dd" title="Belum ada transaksi" text="Mulai catat dari yang kecil, misalnya kopi pagi ini. Kebiasaan kecil, hasilnya besar!" action="openTransaction()" actionLabel="Catat transaksi"}}
      </template>
      <ul class="list">
        <template x-for="t in summary.recent" :key="t.id">
          <li class="row" x-data="{ s: style(t) }">
            <span class="avatar" :style="{ background: t.category_color ?? '#64748b' }">
              <i class="ph-duotone" :class="'ph-' + (t.category_icon ?? s.icon)"></i>
            </span>
            <div class="row-main">
              <strong x-text="transactionTitle(t)"></strong>
              <span class="muted" x-text="formatDate(t.date)"></span>
            </div>
            <strong :class="'tone-' + s.tone" x-text="transactionAmount(t)"></strong>
          </li>
        </template>
      </ul>
    </div>
  </div>
</section>
