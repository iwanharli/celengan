{{!-- Halaman: Transaksi --}}
<section class="page stack" x-show="page === 'transactions'">
  <!-- Baris alat: cari · jenis · filter lain (panel) · baru dihapus · tambah -->
  <div class="tx-toolbar">
    <label class="search">
      <i class="ph-duotone ph-magnifying-glass"></i>
      <input type="search" placeholder="Cari catatan atau kategori…" x-model.debounce.400ms="filters.q" @input.debounce.400ms="reload()">
    </label>
    <div class="segmented kind-filter">
      <template x-for="[value, label] in [['', 'Semua'], ['income', 'Masuk'], ['expense', 'Keluar'], ['transfer', 'Transfer']]" :key="value">
        <button type="button" :class="{ active: filters.kind === value }" @click="filters.kind = value; reload()" x-text="label"></button>
      </template>
    </div>
    <button type="button" class="button" :class="{ 'filter-on': extraFilterCount }" @click="showTxFilters = !showTxFilters">
      <i class="ph-duotone ph-funnel-simple"></i> Filter
      <span class="count" x-show="extraFilterCount" x-text="extraFilterCount"></span>
    </button>
    <button type="button" class="icon-button" @click="openDeletedTransactions()" title="Transaksi yang baru dihapus"><i class="ph-duotone ph-trash-simple"></i></button>
    <button class="button primary" @click="openTransaction()"><i class="ph-duotone ph-plus"></i> Tambah</button>
  </div>

  <div class="tx-filters" x-show="showTxFilters || extraFilterCount">
    <div class="field">
      <label>Akun</label>
      <select x-model="filters.account_id" @change="reload()">
        <option value="">Semua akun</option>
        <template x-for="a in accounts" :key="a.id"><option :value="a.id" x-text="a.name"></option></template>
      </select>
    </div>
    <div class="field">
      <label>Kategori</label>
      <select x-model="filters.category_id" @change="reload()">
        <option value="">Semua kategori</option>
        <optgroup label="Pengeluaran">
          <template x-for="c in categoriesOf('expense')" :key="c.id"><option :value="c.id" x-text="c.name"></option></template>
        </optgroup>
        <optgroup label="Pemasukan">
          <template x-for="c in categoriesOf('income')" :key="c.id"><option :value="c.id" x-text="c.name"></option></template>
        </optgroup>
      </select>
    </div>
    <div class="field">
      <label>Nominal</label>
      <div class="range-inputs">
        <input inputmode="numeric" placeholder="min" x-model="filters.min" x-rupiah @input.debounce.500ms="reload()">
        <span class="muted">–</span>
        <input inputmode="numeric" placeholder="maks" x-model="filters.max" x-rupiah @input.debounce.500ms="reload()">
      </div>
    </div>
    <div class="field">
      <label>Urutkan</label>
      <select x-model="filters.sort" @change="reload()">
        <option value="newest">Terbaru dulu</option>
        <option value="oldest">Terlama dulu</option>
        <option value="largest">Nominal terbesar</option>
        <option value="smallest">Nominal terkecil</option>
      </select>
    </div>
    <div class="field" x-show="recipients.length">
      <label>Penerima</label>
      <select x-model="filters.recipient_id" @change="filters.bill_id = ''; reload()">
        <option value="">Semua penerima</option>
        <template x-for="r in recipients" :key="r.id"><option :value="r.id" x-text="r.name"></option></template>
      </select>
    </div>
    <div class="field" x-show="bills.length || endedBills.length">
      <label>Tagihan</label>
      <select x-model="filters.bill_id" @change="filters.recipient_id = ''; reload()">
        <option value="">Semua tagihan</option>
        <template x-for="b in [...bills.filter((b) => !b.debt_id), ...endedBills]" :key="b.id"><option :value="b.id" x-text="b.name + (b.active === false ? ' (berhenti)' : '')"></option></template>
      </select>
    </div>
    <div class="field">
      <label>Foto bukti</label>
      <div class="segmented compact">
        <template x-for="[value, label] in [['', 'Semua'], ['yes', 'Ada'], ['no', 'Tidak ada']]" :key="value">
          <button type="button" :class="{ active: filters.photos === value }" @click="filters.photos = value; reload()" x-text="label"></button>
        </template>
      </div>
    </div>
    <div class="tx-filters-actions">
      <span class="muted" x-text="transactions.length + ' transaksi'"></span>
      <button type="button" class="link" x-show="hasFilters" @click="resetFilters()">Hapus semua filter</button>
    </div>
  </div>

  <div class="card">
    <template x-if="transactions.length === 0 && hasFilters">
      {{> components/empty-state emoji="1f50d" title="Tidak ditemukan" text="Tidak ada transaksi yang cocok dengan pencarian atau filter ini." action="resetFilters()" actionLabel="Hapus filter" icon="x" secondary=true}}
    </template>
    <template x-if="transactions.length === 0 && !hasFilters">
      {{> components/empty-state emoji="1f4dd" title="Belum ada transaksi di bulan ini" text="Transaksi yang kamu catat akan muncul di sini, lengkap dengan kategori dan akunnya." action="openTransaction()" actionLabel="Catat transaksi"}}
    </template>
    <ul class="list">
      <template x-for="t in transactions" :key="t.id">
        <li class="row" x-data="{ s: style(t) }">
          <span class="avatar" :style="{ background: t.category_color ?? '#64748b' }">
            <i class="ph-duotone" :class="'ph-' + (t.category_icon ?? s.icon)"></i>
          </span>
          <div class="row-main">
            <strong x-text="transactionTitle(t)"></strong>
            <span class="muted" x-text="formatDate(t.date) + ' · ' + transactionSubtitle(t)"></span>
          </div>
          <button class="photo-badge" x-show="t.attachments.length" @click="openPhotos(t)" :title="t.attachments.length + ' foto'">
            <i class="ph-duotone ph-paperclip"></i> <span x-text="t.attachments.length"></span>
          </button>
          <strong :class="'tone-' + s.tone" x-text="transactionAmount(t)"></strong>
          <button class="icon-button subtle" title="Edit" @click="editTransaction(t)">
            <i class="ph-duotone ph-pencil-simple"></i>
          </button>
          <button class="icon-button subtle" title="Hapus"
            @click="deleteTransaction(t)">
            <i class="ph-duotone ph-trash"></i>
          </button>
        </li>
      </template>
    </ul>
  </div>
</section>
